{
  "rules": {
    ".read": false,
    ".write": false,

    "taxinexo": {
      "config": {
        ".read": "auth != null",
        "admin": { ".read": false, ".write": false },
        "codigo_bonus":  { ".read": "auth != null", ".write": false },
        "codigo_roleta": { ".read": "auth != null", ".write": false },
        "link_grupo":    { ".read": true, ".write": false },
        "marca":         { ".read": true, ".write": false }
      },

      "usuarios": {
        ".read": false,
        ".write": false,
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()"
        }
      },
      "email_index":      { ".read": false, ".write": false },
      "identifier_index": { ".read": false, ".write": false },
      "codigo_index":     { ".read": false, ".write": false },
      "indicados_index":  { ".read": false, ".write": false },

      "transacoes":         { ".read": false, ".write": false },
      "transacoes_usuario": {
        ".read": false, ".write": false,
        "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
      },

      "investimentos":          { ".read": false, ".write": false },
      "investimentos_usuario": {
        ".read": false, ".write": false,
        "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
      },

      "plataforma":        { ".read": false, ".write": false },
      "controle":          { ".read": false, ".write": false },
      "marketing_banners": { ".read": true,  ".write": false }
    }
  }
}
